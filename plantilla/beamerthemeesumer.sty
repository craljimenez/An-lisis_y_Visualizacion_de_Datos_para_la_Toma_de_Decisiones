% ============================================================
%  beamerthemeesumer.sty
%  Tema Beamer institucional — ESUMER / Estud-IA
%  Curso: Análisis y Visualización de Datos para la Toma de Decisiones
%
%  Colores tomados de la plantilla oficial:
%  "Plantilla presentación Estud-IA y ESUMER.pptx"
%
%  Uso:  \usetheme{esumer}
% ============================================================
\ProvidesPackage{beamerthemeesumer}

\RequirePackage{tikz}
\RequirePackage{fontspec}
\usetikzlibrary{calc}

% ---------- Tipografía ----------
% Aptos no suele estar disponible en Linux/TeX Live; se usa una
% alternativa geométrica de aspecto similar. Cambiar si se dispone
% de la fuente Aptos/Aptos Display instalada.
\IfFontExistsTF{Aptos}{%
  \setmainfont{Aptos}
  \setsansfont{Aptos Display}
}{%
  \setmainfont{Lato}
  \setsansfont{Lato}
}

% ---------- Paleta de color oficial ----------
\definecolor{esumerNavy}{HTML}{262E66}   % azul institucional (fondo de portada)
\definecolor{esumerNavyDark}{HTML}{1E4093} % azul secundario (degradado inferior)
\definecolor{esumerTeal}{HTML}{0CB3B6}   % verde azulado (bloque geométrico)
\definecolor{esumerSky}{HTML}{26A1DB}    % azul cielo (bloque geométrico)
\definecolor{esumerOrange}{HTML}{EF7C2C} % naranja Estud-IA
\definecolor{esumerGreen}{HTML}{94C122}  % verde Estud-IA
\definecolor{esumerMagenta}{HTML}{AF348B}% magenta Estud-IA
\definecolor{esumerGray}{HTML}{E8E8E8}   % gris claro de bloques
\definecolor{esumerBg}{HTML}{F7F8FA}     % fondo de contenido

% ---------- Colores Beamer ----------
\setbeamercolor{normal text}{fg=black,bg=esumerBg}
\setbeamercolor{structure}{fg=esumerNavy}
\setbeamercolor{palette primary}{fg=white,bg=esumerNavy}
\setbeamercolor{palette secondary}{fg=white,bg=esumerSky}
\setbeamercolor{palette tertiary}{fg=white,bg=esumerTeal}
\setbeamercolor{title}{fg=white,bg=}
\setbeamercolor{subtitle}{fg=esumerGray}
\setbeamercolor{frametitle}{fg=esumerNavy,bg=esumerBg}
\setbeamercolor{block title}{fg=white,bg=esumerNavy}
\setbeamercolor{block body}{fg=black,bg=esumerGray!40}
\setbeamercolor{block title alerted}{fg=white,bg=esumerOrange}
\setbeamercolor{block body alerted}{fg=black,bg=esumerOrange!12}
\setbeamercolor{block title example}{fg=white,bg=esumerTeal}
\setbeamercolor{block body example}{fg=black,bg=esumerTeal!12}
\setbeamercolor{itemize item}{fg=esumerOrange}
\setbeamercolor{itemize subitem}{fg=esumerSky}
\setbeamercolor{footline}{fg=white,bg=esumerNavy}
\setbeamercolor{page number in head/foot}{fg=white}

\setbeamertemplate{itemize item}{\raisebox{0.15ex}{\scriptsize$\blacktriangleright$}}
\setbeamertemplate{itemize subitem}{\raisebox{0.1ex}{\scriptsize$\bullet$}}
\setbeamerfont{frametitle}{series=\bfseries,size=\Large}
\setbeamerfont{title}{series=\bfseries,size=\LARGE}

% Metadatos propios del curso (se definen en cada clase)
\newcommand{\cursonombre}{Análisis y Visualización de Datos para la Toma de Decisiones}
\newcommand{\modulonombre}{}
\newcommand{\semananumero}{}
\newcommand{\clasenumero}{}
\newcommand{\fechaclase}{}
\newcommand{\modalidadclase}{}

\newcommand{\setmodulo}[1]{\renewcommand{\modulonombre}{#1}}
\newcommand{\setsemana}[1]{\renewcommand{\semananumero}{#1}}
\newcommand{\setclase}[1]{\renewcommand{\clasenumero}{#1}}
\newcommand{\setfechaclase}[1]{\renewcommand{\fechaclase}{#1}}
\newcommand{\setmodalidad}[1]{\renewcommand{\modalidadclase}{#1}}

\newcommand{\logoesumer}{plantilla/assets/esumer-logo.png}
\newcommand{\logoesumerblanco}{plantilla/assets/esumer-logo-white.png}

% ---------- Motivo geométrico (triángulos, esquina) ----------
% Reproduce el bloque angular teal/azul de la plantilla oficial,
% redibujado en TikZ para que escale sin depender de un raster.
\newcommand{\motivoesumer}[1][1]{%
  \begin{tikzpicture}[remember picture,overlay,scale=#1]
    \coordinate (TR) at ($(current page.north east)$);
    \fill[esumerSky]   ($(TR)+(-2.6,0)$)      -- ($(TR)+(0,0)$)      -- ($(TR)+(0,-1.4)$)   -- ($(TR)+(-1.2,-1.4)$) -- cycle;
    \fill[esumerTeal]  ($(TR)+(-1.2,-1.4)$)   -- ($(TR)+(0,-1.4)$)   -- ($(TR)+(0,-3.0)$)   -- ($(TR)+(-1.2,-3.0)$) -- cycle;
    \fill[esumerNavyDark] ($(TR)+(-2.6,-3.0)$) -- ($(TR)+(0,-3.0)$)  -- ($(TR)+(0,-4.6)$)   -- cycle;
  \end{tikzpicture}%
}

% ---------- Portada ----------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[esumerNavy] (current page.south west) rectangle (current page.north east);
    % motivo geométrico esquina superior derecha
    \begin{scope}
      \clip (current page.north east) rectangle ($(current page.north east)+(-4.6,-4.6)$);
      \fill[esumerSky]  ($(current page.north east)+(-4.6,0)$) rectangle ($(current page.north east)+(-1.6,-2.3)$);
      \fill[esumerTeal] ($(current page.north east)+(-3.4,-1.0)$) rectangle ($(current page.north east)+(0,-4.6)$);
      \fill[esumerNavyDark,opacity=.9] ($(current page.north east)+(-4.6,-3.6)$) -- ($(current page.north east)+(0,-3.6)$) -- ($(current page.north east)+(0,-4.6)$) -- ($(current page.north east)+(-4.6,-4.6)$) -- cycle;
    \end{scope}
    \node[anchor=north west,inner sep=0pt] at ($(current page.north west)+(0.9,-0.8)$)
      {\includegraphics[height=0.9cm]{\logoesumerblanco}};
    \node[anchor=south west,inner sep=0pt,text width=10.5cm,align=left] at ($(current page.south west)+(1.0,3.3)$)
      {\color{esumerOrange}\rule{2.2mm}{2.2cm}\hspace{3mm}%
       \begin{minipage}[b]{9.5cm}\raggedright
       {\usebeamerfont{title}\usebeamercolor[fg]{title}\inserttitle\par}
       \end{minipage}};
    \node[anchor=south west,inner sep=0pt,text width=10.5cm,align=left] at ($(current page.south west)+(1.0,2.1)$)
      {\color{esumerGray}\large\insertsubtitle};
    \node[anchor=south west,inner sep=0pt] at ($(current page.south west)+(1.0,0.9)$)
      {\color{white}\small
       \begin{tabular}{@{}l@{}}
         Módulo: \modulonombre \\
         Semana \semananumero\ · Clase \clasenumero\ · \fechaclase\ · \modalidadclase \\
         \insertauthor \; — \; \insertdate
       \end{tabular}};
  \end{tikzpicture}
}

% ---------- Encabezado de diapositiva de contenido ----------
\setbeamertemplate{frametitle}{%
  \nointerlineskip
  \begin{tikzpicture}[remember picture,overlay]
    \fill[esumerNavy] (current page.north west) rectangle ($(current page.north east)+(0,-1.05)$);
    \fill[esumerOrange] ($(current page.north west)+(0,-1.05)$) rectangle ($(current page.north west)+(0.18,-1.15)$);
    \node[anchor=west,text=white,font=\bfseries\Large] at ($(current page.north west)+(0.5,-0.55)$) {\insertframetitle};
    \node[anchor=east,text=esumerGray,font=\scriptsize] at ($(current page.north east)+(-0.4,-0.55)$)
      {Semana \semananumero\ · Clase \clasenumero};
  \end{tikzpicture}
  \vspace{0.75cm}
}

% ---------- Pie de página ----------
\setbeamertemplate{footline}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[esumerNavy] (current page.south west) rectangle ($(current page.south east)+(0,0.45)$);
    \node[anchor=west,inner sep=0pt] at ($(current page.south west)+(0.4,0.225)$)
      {\includegraphics[height=0.32cm]{\logoesumerblanco}};
    \node[anchor=west,text=esumerGray,font=\tiny] at ($(current page.south west)+(3.0,0.225)$)
      {\cursonombre};
    \node[anchor=east,text=white,font=\tiny] at ($(current page.south east)+(-0.4,0.225)$)
      {\insertframenumber/\inserttotalframenumber};
  \end{tikzpicture}
}

% ---------- Diapositiva de sección ----------
\setbeamertemplate{section page}{
  \begin{tikzpicture}[remember picture,overlay]
    \fill[esumerNavy] (current page.south west) rectangle (current page.north east);
    \fill[esumerOrange] ($(current page.west)+(0,1.1)$) rectangle ($(current page.west)+(0.18,-1.1)$);
    \node[anchor=west,text width=10cm,align=left] at ($(current page.west)+(0.7,0)$)
      {\color{white}\Huge\bfseries\insertsectionhead};
  \end{tikzpicture}
}

\setbeamertemplate{navigation symbols}{}
\endinput
